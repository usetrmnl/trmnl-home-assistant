#!/command/execlineb -P
# As www-data, like LaraPaper's own image: the add-on runs as root to take ownership of
# /data, and s6 would otherwise start this as root too. s6-setuidgid keeps root's HOME
# (/root, which www-data can't write), where Chromium fails to start ("Failed to create
# headless user data directory"), so every render in a queued job failed: give it
# www-data's own.
s6-setuidgid www-data
export HOME /home/www-data
cd /var/www/html
php /var/www/html/artisan queue:work -v --tries=3
